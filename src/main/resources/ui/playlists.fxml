<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.luciferc137.cmp.ui.controllers.PlaylistController">
    <HBox fx:id="customTabHeader">
        <ToggleButton fx:id="queueTabButton" text="Queue" HBox.hgrow="ALWAYS"
                      maxWidth="Infinity" styleClass="custom-tab-button" />
        <ToggleButton fx:id="playlistsTabButton" text="Playlists" HBox.hgrow="ALWAYS"
                      maxWidth="Infinity" styleClass="custom-tab-button" />
    </HBox>
    <TabPane fx:id="tabPane" tabMaxHeight="0" VBox.vgrow="ALWAYS">
        <!-- Queue Tab -->
        <Tab text="Queue" closable="false">
            <VBox fx:id="queuePane">
                <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="Playback Queue" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 3 3 3;">
                    <Button fx:id="clearQueueButton" onAction="#onClearQueue" text="❌" prefHeight="40" prefWidth="40" style="-fx-font-size: 17px;">
                        <tooltip>
                            <Tooltip text="Clear the queue" />
                        </tooltip>
                    </Button>
                    <Button fx:id="loopModeButton" onAction="#onLoopMode" text="🔁" prefHeight="40" prefWidth="40" style="-fx-font-size: 17px;"/>
                    <Button fx:id="shuffleQueueButton" onAction="#onShuffleQueue" text="🔀" prefHeight="40" prefWidth="40" style="-fx-font-size: 17px;">
                        <tooltip>
                            <Tooltip text="Shuffle the queue" />
                        </tooltip>
                    </Button>
                    <Button fx:id="syncQueueButton" onAction="#toggleSyncQueue" text="⇅"  prefHeight="40" prefWidth="40" styleClass="sync-button" style="-fx-font-size: 17px;">
                        <tooltip>
                            <Tooltip text="Follow current track" />
                        </tooltip>
                    </Button>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="queueSortComboBox" prefWidth="150" promptText="Sort by"/>
                    <Button fx:id="orderButton" onAction="#onSwitchOrder" text="⬇" prefWidth="30" alignment="CENTER_RIGHT">
                        <tooltip>
                            <Tooltip text="Switch order" />
                        </tooltip>
                    </Button>
                </HBox>
                <!-- Playlist content -->
                <TableView fx:id="queueTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="queueTitleColumn" prefWidth="410" text="Title"/>
                        <TableColumn fx:id="queueRatingColumn" prefWidth="90" text="Rating"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <!-- Playlist Tab -->
        <Tab text="Playlists" closable="false">
            <VBox>
                <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="Playlists" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                </HBox>
                <!-- Playlist tabs header -->
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <ScrollPane fx:id="playlistTabsScrollPane" hbarPolicy="NEVER" vbarPolicy="NEVER"
                                fitToHeight="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <HBox fx:id="playlistTabsContainer" spacing="3" alignment="CENTER_LEFT"/>
                    </ScrollPane>
                    <Button fx:id="managePlaylistsButton" onAction="#onManagePlaylists" text="⚙" prefWidth="40"
                            style="-fx-font-size: 16px;"/>
                </HBox>

                <!-- Playlist content -->
                <TableView fx:id="playlistTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="playlistTitleColumn" prefWidth="410" text="Title"/>
                        <TableColumn fx:id="playlistRatingColumn" prefWidth="90" text="Rating"/>
                    </columns>
                </TableView>

                <!-- Playlist info -->
                <Label fx:id="playlistInfoLabel" text="0 tracks" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>